# Frontend API base URL. Set this to your deployed backend API origin plus `/api`.
VITE_API_BASE_URL="http://localhost:8000/api"

# Backend PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stripkaka_db"

# Set to "true" to render hard-coded sample trips when the API is unreachable
# (Phu Quoc / Hue demo data). Leave unset / "false" in normal use so the UI
# shows real loading / empty / error states instead of fake content.
# VITE_ENABLE_SAMPLE_TRIPS="false"
